# Sandbox credentials only. Never add real credentials to GitHub.
PAYPAL_CLIENT_ID=replace_with_sandbox_client_id
PAYPAL_CLIENT_SECRET=replace_with_sandbox_client_secret
# Optional until you configure a real Sandbox webhook subscription.
PAYPAL_WEBHOOK_ID=
# Keep this exact origin in your browser and PayPal return URLs.
PUBLIC_BASE_URL=http://localhost:3000
HOST=127.0.0.1
PORT=3000
# Optional. If blank, a temporary organizer access key is printed at startup.
# This is your SplitSync organizer key, NOT a PayPal password or Client Secret.
ORGANIZER_TOKEN=
# For Flutter web testing only: flutter run -d chrome --web-port=5173
FLUTTER_WEB_ORIGIN=http://localhost:5173
# Local payment ledger (ignored by Git). Run one server process per ledger.
DATA_FILE=./data/sandbox-ledger.json

# Hosted DeepSeek and Chatterbox (server only).
NVIDIA_API_KEY=
# Optional path to Python with nvidia-riva-client installed.
NVIDIA_PYTHON=python
